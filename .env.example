# Register a Web JS API key at https://console.amap.com/dev/key/app and bind its allowed domains.
# Keys created after 2021-12-02 normally also require the matching securityJsCode.
# Copy this file to .env.local, replace the placeholders, then restart Vite.
VITE_AMAP_KEY=replace_with_your_amap_web_js_key
VITE_AMAP_SECURITY_JS_CODE=replace_with_your_amap_security_js_code
